{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mode": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git branch": "allow",
          "git commit*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "git push*": "deny",
          "git reset*": "ask",
          "git show*": "allow",
          "git status": "allow",
          "java*": "allow",
          "javac*": "allow",
          "mvnw*": "allow"
        },
        "codesearch": "allow",
        "doom_loop": "deny",
        "edit": "ask",
        "external_directory": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "question": "allow",
        "read": "allow",
        "skill": "ask",
        "task": "ask",
        "todowrite": "allow",
        "webfetch": "ask",
        "websearch": "ask"
      }
    }
  },
  "model": "openai/gpt-5.3-codex",
  "provider": {
    "ollama": {
      "models": {
        "glm-4.7-flash": {
          "_launch": true,
          "name": "glm-4.7-flash"
        },
        "glm-4.7:cloud": {
          "_launch": true,
          "limit": {
            "context": 202752,
            "output": 131072
          },
          "name": "glm-4.7:cloud"
        },
        "glm-5:cloud": {
          "_launch": true,
          "limit": {
            "context": 202752,
            "output": 131072
          },
          "name": "glm-5:cloud"
        },
        "llama3.1": {
          "_launch": true,
          "name": "llama3.1"
        },
        "qwen3-coder-next:cloud": {
          "_launch": true,
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "name": "qwen3-coder-next:cloud"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "share": "disabled"
}
